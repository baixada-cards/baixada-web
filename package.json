{
  "name": "@baixada-cards/baixada-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=11.19.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:cloud-run": "next build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:cloud-run": "node .next/standalone/server.js",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@baixada-cards/design-system": "git+https://github.com/baixada-cards/design-system.git#82638b7cdabbb56a4bce7b953e8571847bf6fda9",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.9",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "10.10.0",
    "react-server-dom-webpack": "19.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vinext": "1.0.0-beta.9",
    "vite": "8.3.0",
    "wrangler": "4.131.2"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.4",
    "undici": "7.29.0"
  },
  "type": "module",
  "packageManager": "npm@11.19.1"
}
